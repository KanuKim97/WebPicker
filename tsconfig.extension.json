{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src/extension",
    "types": []
  },
  "include": ["src/extension/**/*.ts", "src/types/**/*.d.ts"]
}
