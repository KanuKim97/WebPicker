{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "0.1.0",
  "action": {
    "default_title": "__MSG_extensionActionTitle__"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ollama_request_headers",
        "enabled": true,
        "path": "rules/ollama-request-headers.json"
      }
    ]
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "declarativeNetRequestWithHostAccess", "scripting", "sidePanel", "storage", "tabs"],
  "host_permissions": ["http://localhost:11434/*", "http://127.0.0.1:11434/*"],
  "minimum_chrome_version": "116"
}
